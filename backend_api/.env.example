# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS
# Frontend is expected to run at http://localhost:3000 in dev
CORS_ORIGIN=http://localhost:3000

# Database (Postgres)
# Set ONE of these:
DATABASE_URL=postgresql://appuser:dbuser123@localhost:5000/myapp
# Or granular (used if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5000
PGDATABASE=myapp
PGUSER=appuser
PGPASSWORD=dbuser123
PGSSLMODE=disable

# Auth / JWT
JWT_SECRET=CHANGE_ME__USE_A_LONG_RANDOM_SECRET
JWT_ISSUER=secure-access-portal
JWT_AUDIENCE=secure-access-portal-web
JWT_EXPIRES_IN=15m

# Refresh tokens (optional cookie-based)
REFRESH_TOKEN_ENABLED=true
REFRESH_TOKEN_EXPIRES_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAMESITE=lax
